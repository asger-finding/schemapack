{
  "name": "@asger-finding/schemapack",
  "version": "2.0.0",
  "description": "The fastest and smallest JavaScript object serialization library. Efficiently encode your objects in to compact byte buffers and then decode them back in to objects on the receiver. Integrates very well with WebSockets.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/schemapack.d.ts",
      "default": "./dist/schemapack.js"
    }
  },
  "unpkg": "./dist/schemapack.min.js",
  "jsdelivr": "./dist/schemapack.min.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/browser.ts --bundle --minify --format=iife --outfile=dist/schemapack.min.js",
    "prepare": "npm run build",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "npm run build && tsc && node --test \"test/*.test.ts\"",
    "bench": "node bench/bench.ts player && node bench/bench.ts state && node bench/bench.ts delta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asger-finding/schemapack.git"
  },
  "keywords": [
    "schema",
    "pack",
    "binary",
    "websocket",
    "serialize",
    "serialization",
    "schemapack",
    "bytebuffer",
    "buffer",
    "arraybuffer",
    "net"
  ],
  "author": "Asger Finding",
  "contributors": [
    "phretaddin"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/asger-finding/schemapack/issues"
  },
  "homepage": "https://github.com/asger-finding/schemapack#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^26.6.4",
    "avsc": "^5.7.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "mitata": "^1.0.34",
    "msgpackr": "^2.1.0",
    "protobufjs": "^8.8.0",
    "roughjs": "^4.6.6",
    "schemapack": "^1.4.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
